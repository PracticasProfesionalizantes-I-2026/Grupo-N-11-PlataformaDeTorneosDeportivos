meta {
  name: CU-05 - Nombre de Equipo Duplicado en Torneo (409)
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/torneos/{{torneoId}}/equipos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Los Halcones FC",
    "jugadores": [
      { "nombre": "Otro", "apellido": "Jugador", "dni": "77889900" }
    ]
  }
}

tests {
  test("Status code is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });
}