meta {
  name: CU-05 - Crear Equipo Exitoso (201)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/torneos/{{torneoId}}/equipos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Los Halcones FC",
    "logoUrl": "https://example.com/logo.png",
    "jugadores": [
      {
        "nombre": "Juan",
        "apellido": "Perez",
        "dni": "12345678",
        "documentacionUrl": "https://example.com/doc1.pdf"
      },
      {
        "nombre": "Carlos",
        "apellido": "Lopez",
        "dni": "23456789",
        "documentacionUrl": "https://example.com/doc2.pdf"
      },
      {
        "nombre": "Lucas",
        "apellido": "Gomez",
        "dni": "34567890",
        "documentacionUrl": "https://example.com/doc3.pdf"
      },
      {
        "nombre": "Marcos",
        "apellido": "Diaz",
        "dni": "45678901",
        "documentacionUrl": "https://example.com/doc4.pdf"
      },
      {
        "nombre": "Diego",
        "apellido": "Romero",
        "dni": "56789012",
        "documentacionUrl": "https://example.com/doc5.pdf"
      }
    ]
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
