meta {
  name: CU-11 - Partido No Habilitado para Incidencias (409)
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/partidos/{{partidoId}}/incidencias
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "tipoIncidencia": 1,
    "minuto": 90,
    "jugadorId": "{{jugadorId}}",
    "equipoId": "{{equipoId}}"
  }
}

tests {
  test("Status code is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });
}