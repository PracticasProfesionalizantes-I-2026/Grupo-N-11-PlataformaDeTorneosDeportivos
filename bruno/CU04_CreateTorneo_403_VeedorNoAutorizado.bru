meta {
  name: CU-04 - Veedor No Autorizado a Crear Torneo (403)
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/torneos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtTokenVeedor}}
}

body:json {
  {
    "nombre": "Torneo Creado Por Veedor",
    "disciplinaId": 1,
    "modalidad": 0,
    "cupoMaximo": 8,
    "esPago": false
  }
}

tests {
  test("Status code is 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
