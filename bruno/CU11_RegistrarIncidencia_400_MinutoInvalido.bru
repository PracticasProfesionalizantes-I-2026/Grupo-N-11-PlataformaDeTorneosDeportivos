meta {
  name: CU-11 - Minuto Fuera de Rango (400)
  type: http
  seq: 50
}

post {
  url: {{baseUrl}}/partidos/{{partidoId}}/incidencias
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "tipoIncidencia": 0,
    "minuto": -5,
    "jugadorId": "{{jugadorId}}",
    "equipoId": "{{equipoId}}"
  }
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}