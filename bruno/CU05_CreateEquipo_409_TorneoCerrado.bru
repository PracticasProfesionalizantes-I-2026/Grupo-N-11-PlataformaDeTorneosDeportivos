meta {
  name: CU-05 - Torneo Cerrado a Inscripcion (409)
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/torneos/{{torneoId}}/equipos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Equipo Tardio",
    "jugadores": [
      { "nombre": "Carlos", "apellido": "Tevez", "dni": "28111222" }
    ]
  }
}

tests {
  test("Status code is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });
}