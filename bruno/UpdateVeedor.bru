meta {
  name: CU-07 - Actualizar Veedor Exitoso (200)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/veedores/{{veedorId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Roberto Carlos",
    "apellido": "Gomez",
    "telefono": "9988776655",
    "sedeAsignada": "Sede Norte"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
