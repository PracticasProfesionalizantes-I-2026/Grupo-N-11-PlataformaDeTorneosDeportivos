meta {
  name: CU-02 - Credenciales Incorrectas (401)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "emailOrDni": "usuario.inexistente@torneos.com",
    "password": "WrongPassword123!"
  }
}

tests {
  test("Status code is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}