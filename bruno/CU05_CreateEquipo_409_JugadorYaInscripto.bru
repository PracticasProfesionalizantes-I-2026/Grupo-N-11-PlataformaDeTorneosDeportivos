meta {
  name: CU-05 - Jugador Ya Inscripto en Otro Equipo RN-02 (409)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/torneos/{{torneoId}}/equipos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Segundo Equipo del Jugador",
    "jugadores": [
      { "nombre": "Juan", "apellido": "Perez", "dni": "12345678" }
    ]
  }
}

tests {
  test("Status code is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });
}