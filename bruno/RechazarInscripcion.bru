meta {
  name: CU-06 - Rechazar Inscripcion Con Motivo RN-03 (200)
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/torneos/{{torneoId}}/equipos/{{equipoId}}/rechazar
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "motivoRechazo": "Falta adjuntar fotocopia de DNI de los jugadores 1 y 2."
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
