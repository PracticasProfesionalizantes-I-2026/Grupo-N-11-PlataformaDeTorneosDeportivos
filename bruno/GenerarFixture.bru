meta {
  name: CU-08 - Solicitar Generacion Fixture Exitoso (200)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/torneos/{{torneoId}}/generar-fixture
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "fechaInicio": "2026-11-01T10:00:00Z",
    "horarios": [
      "10:00",
      "12:00",
      "15:00",
      "17:00"
    ],
    "sedes": [
      "Cancha Principal",
      "Cancha 2"
    ]
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
