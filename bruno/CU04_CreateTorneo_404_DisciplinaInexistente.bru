  seq: 22
}

post {
  url: {{baseUrl}}/torneos
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "nombre": "Torneo Sin Disciplina",
    "disciplinaId": 9999,
    "modalidad": 0,
    "cupoMaximo": 8,
    "esPago": false
  }
}

tests {
  test("Status code is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}