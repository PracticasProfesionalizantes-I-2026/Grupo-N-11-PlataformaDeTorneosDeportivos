meta {
  name: CU-11 - Jugador No Pertenece a Planteles (422)
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/partidos/{{partidoId}}/incidencias
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwtToken}}
}

body:json {
  {
    "tipoIncidencia": 0,
    "minuto": 22,
    "jugadorId": "00000000-0000-0000-0000-000000000099",
    "equipoId": "{{equipoId}}"
  }
}

tests {
  test("Status code is 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
}